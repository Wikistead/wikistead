# E2E environment — points at the ISOLATED e2e middleware (docker-compose.e2e.yml,
# project wikistead-e2e). Distinct ports from dev so the two stacks coexist and
# the e2e data layer is fully separate. NODE_ENV=development keeps the dev-token
# bypass available for headless tests.
NODE_ENV=development

# Postgres (e2e: host 5433)
DATABASE_URL=postgres://app:app@localhost:5433/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5433/app

# Valkey (e2e: host 6380)
VALKEY_URL=redis://localhost:6380

# OpenFGA (e2e: host 8090). STORE_ID/MODEL_ID are filled in by setup:e2e
# (fga:bootstrap output is written back here).
OPENFGA_API_URL=http://localhost:8090
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# Meilisearch (e2e: host 7701)
MEILI_HOST=http://localhost:7701
MEILI_MASTER_KEY=dev_master_key_change_me

# S3-compatible storage (e2e: host 9002, SeaweedFS).
S3_ENDPOINT=http://localhost:9002
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true
# Plain browser presigned-PUT compatibility (no checksum header). See .env.example.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# Member auth (unused on the dev-token path, but required at module load)
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=wikistead
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=http://dev.localhost:4010/auth/callback
OIDC_SECRET_ENC_KEY=7yMsXpBHk5/8edVzkeyWcjhYQTyj7EZDAd3Mz6KQHFo=

SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
EMAIL_FROM=wikistead <e2e@wikistead.local>

# Guest share tokens — short TTL (minutes) so revocation is prompt in tests.
GUEST_TOKEN_SECRET=e2e_guest_secret
GUEST_TOKEN_TTL_SECONDS=300

# Ports for the e2e app processes (started by Playwright webServer).
SERVER_PORT=4010
COLLAB_PORT=4110
WEB_PORT=5180

# Share-link exchange rate limit (#107): raised for e2e — the whole suite hits the
# public exchange endpoint from one localhost IP; prod uses the defaults (30/IP, 10/link).
EXCHANGE_RL_IP_MAX=100000
EXCHANGE_RL_LINK_MAX=100000
