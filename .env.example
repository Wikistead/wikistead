# Sample configuration for a development checkout. It is NOT the complete list of what this product
# reads: `docs/generated/env-reference.md` is generated from the code and names every variable, its
# default and what it does (#734 / ADR-237). This file is the subset a local checkout needs to start.

# ---- shared ----
NODE_ENV=development

# ---- Postgres ----
# DATABASE_URL       — restricted runtime role (NOSUPERUSER, NOBYPASSRLS). Used by server/collab.
# DATABASE_ADMIN_URL — superuser. Used by the migration runner only. Keep out of app processes.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/app

# ---- Valkey (Redis-compatible; used by Hocuspocus for horizontal scale) ----
VALKEY_URL=redis://localhost:6379

# ---- OpenFGA (ReBAC authorization) ----
# Dev OpenFGA runs on the PERSISTENT postgres datastore (#338 / ADR-128), so these ids survive a restart once
# set. `pnpm dev:up` (or `pnpm dev:setup`) fills them on first run; leave blank until then.
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ---- Meilisearch (external full-text search) ----
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# ---- Tracing (OpenTelemetry, ADR-270 §3.2) ----
# Off unless this names an OTLP/HTTP collector (Jaeger, Tempo, an APM vendor's OTLP ingest). Unset,
# no SDK is loaded and no span is recorded; the server says so once at boot.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ---- SeaweedFS / S3-compatible object storage (ADR-014) ----
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT — the address the BROWSER reaches the store at, when that differs from the one
# the server uses. A presigned URL's SigV4 signature covers the Host header, so a URL signed for
# `seaweedfs:8333` is refused the moment a browser opens it under any other name. Unset means "they
# are the same", which is true for this dev loop (both say localhost:9000) and false for every
# containerised deployment. The `apps` compose profile sets it to https://s3.<SITE_HOST> (#726).
# S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=wksadmin
S3_SECRET_KEY=wksadmin
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true
# Restore the pre-2025 AWS SDK v3 behavior (add request checksums only when the
# operation requires it) so a plain browser presigned-PUT (no checksum header)
# is accepted by S3-compatible gateways. Compatible with MinIO/S3/R2.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# ---- Member auth (OIDC — any compliant IdP, configured per tenant) ----
# Dev: point at whichever IdP you use locally. In production, each tenant
# registers its own OIDC issuer/JWKS in the DB (resolved at request time).
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=wikistead
OIDC_CLIENT_SECRET=change_me
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=http://dev.localhost:4000/auth/callback
# 32-byte AES-256 key (base64) for encrypting tenant OIDC client secrets at rest.
# REQUIRED — the server refuses to boot without it. Generate per deployment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
OIDC_SECRET_ENC_KEY=

# #390: optional, RESET-RESISTANT dev config. When set, `db:seed` mirrors these onto tenant_dev on every run
# (so they survive `docker compose down -v`). Leave blank for the schema defaults (no custom domain,
# enroll_policy=invite_only). The seed marks the domains VERIFIED locally (prod requires the DNS-TXT challenge).
# DEV_CUSTOM_DOMAIN=docs.dev.localhost
# #576: the liveness sweep re-verifies custom domains and demotes one that stops proving ownership.
# DEV_CUSTOM_DOMAIN above is seeded with a placeholder token, so it can never pass — set this to 0 to
# switch the sweep off while developing with it (default 21600000 = 6h; production leaves it alone).
# CUSTOM_DOMAIN_RECHECK_MS=0
# DEV_ENROLL_POLICY=domain            # open | domain | groups | invite_only
# DEV_ENROLL_ALLOWED_GROUPS=eng,admins  # comma-separated, for enroll_policy=groups
# DEV_ENROLL_DOMAIN=dev.localhost     # verified enrol-domain, for enroll_policy=domain

# ---- Email (P1.3) ----
# Dev: Mailpit. Leave SMTP_HOST empty to disable email (invites via copy-link).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=wikistead <dev@wikistead.local>
# Canonical PUBLIC base URL (scheme + root host, port allowed) for links built OFF the request path —
# notification email (#547/ADR-196) is drained by a background worker that has no Host header. Tenant
# links become <scheme>://<tenant-slug>.<host>; a tenant's VERIFIED custom domain wins over this.
# Empty → emails that need links are dropped with a logged reason (never an improvised link).
# WKS_PUBLIC_BASE_URL=http://localhost:5173
# EMAIL_OUTBOX_POLL_MS=5000
# EMAIL_FOLD_WINDOW_S=30   # immediate-mail hold: K mentions inside the window fold into one message
# EMAIL_DIGEST_HOUR=8      # daily digest fires at this hour (in EMAIL_DIGEST_TZ)
# EMAIL_DIGEST_TZ=UTC

# ---- Stripe (billing) ----
# STRIPE_SECRET_KEY      — sk_test_... for dev, sk_live_... for prod
# STRIPE_WEBHOOK_SECRET  — whsec_... from Stripe dashboard webhook settings
# STRIPE_PRICE_PRO       — price_... ID for the pro plan in your Stripe account
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=

# ---- Guest share tokens (app-signed, short-lived) ----
# Used to sign anonymous share-link tokens. Rotate carefully.
# Keep the TTL SHORT (minutes): tokens are minted on demand at the public landing
# endpoint, and after a link is revoked an already-connected guest keeps access
# only until the token expires. Short TTL bounds that revocation window.
GUEST_TOKEN_SECRET=dev_guest_secret_change_me
GUEST_TOKEN_TTL_SECONDS=300

# ---- self-host origin (docker compose --profile apps) ----
# The one public host the whole product answers on (ADR-016, #726). A bare host name: Caddy issues an
# internal certificate for a `.localhost` one (browser warns until `caddy trust`) and a real ACME
# certificate for a name that resolves from the internet. The `s3.` sibling of this host serves
# attachments — see S3_PUBLIC_ENDPOINT above.
SITE_HOST=dev.localhost

# ---- ports ----
SERVER_PORT=4000
COLLAB_PORT=4100
WEB_PORT=5173

# ---- observability (ADR-270) ----
# Prometheus exposition on its own listener (not the API port, never published by the ingress).
# Leave METRICS_TOKEN empty to keep it off; set a long random string to enable, and put the same
# value in your scrape config's bearer_token.
METRICS_TOKEN=
METRICS_PORT=9464

# ---- PlantUML rendering (ADR-074, operator opt-in — OFF by default) ----
# PlantUML is GPL and needs a JRE, so it is never bundled: a ```plantuml block DEGRADES TO ITS SOURCE
# unless an operator points this at a Kroki-compatible render service. Leave it EMPTY and everything
# still works — the block shows its source (Open formats), on the read surface and in the edit panel.
# Setting it sends diagram SOURCE to that service, so a shared/public endpoint (e.g. https://kroki.io)
# means user content leaves your deployment — self-host Kroki if that matters. The server holds the
# endpoint (never the browser): rendering is proxied through the page-view-gated, SSRF-guarded host
# seam, and the client only ever sees image bytes.
PLANTUML_RENDER_URL=

# ---- Login-method ceiling (#537 / ADR-195, operator control — unset = all methods permitted) ----
# CSV of the login methods this DEPLOYMENT permits: tenant-oidc, platform-oidc, saml.
# Tenants select within this ceiling from their admin UI; the effective set is the intersection,
# computed at read time — narrowing the ceiling never rewrites tenant rows, restoring it restores
# their selection. A value naming NO valid method fails at boot (it would 404 every login).
LOGIN_METHODS=
