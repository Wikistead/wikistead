# ---- shared ----
NODE_ENV=development

# ---- Postgres ----
# DATABASE_URL       — restricted runtime role (NOSUPERUSER, NOBYPASSRLS). Used by server/collab.
# DATABASE_ADMIN_URL — superuser. Used by the migration runner only. Keep out of app processes.
DATABASE_URL=postgres://app:app@localhost:5432/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/app

# ---- Valkey (Redis-compatible; used by Hocuspocus for horizontal scale) ----
VALKEY_URL=redis://localhost:6379

# ---- OpenFGA (ReBAC authorization) ----
OPENFGA_API_URL=http://localhost:8080
OPENFGA_STORE_ID=
OPENFGA_MODEL_ID=

# ---- Meilisearch (external full-text search) ----
MEILI_HOST=http://localhost:7700
MEILI_MASTER_KEY=dev_master_key_change_me

# ---- MinIO / S3-compatible object storage ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true

# ---- Member auth (OIDC — any compliant IdP, configured per tenant) ----
# Dev: point at whichever IdP you use locally. In production, each tenant
# registers its own OIDC issuer/JWKS in the DB (resolved at request time).
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=knowledge-saas
OIDC_CLIENT_SECRET=change_me
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json

# ---- Guest share tokens (app-signed, short-lived) ----
# Used to sign anonymous share-link tokens. Rotate carefully.
GUEST_TOKEN_SECRET=dev_guest_secret_change_me
GUEST_TOKEN_TTL_SECONDS=3600

# ---- ports ----
SERVER_PORT=4000
COLLAB_PORT=4100
WEB_PORT=5173
