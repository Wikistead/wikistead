# Server integration-test environment — points at the ISOLATED server-test middleware
# (docker-compose.server-test.yml, project wikistead-server-test). Distinct ports from
# BOTH dev and e2e so all three stacks coexist and the test data layer is fully separate.
# apps/server/vitest.config.ts loads this file (plus .env.server-test.local for the
# bootstrapped FGA store/model ids). NODE_ENV=development keeps parity with the dev suite.
#
# OPENFGA_STORE_ID / OPENFGA_MODEL_ID are intentionally NOT set here — setup:server-test
# runs fga:bootstrap and writes them to .env.server-test.local, which vitest loads FIRST
# (process.loadEnvFile does not override an already-set var).
NODE_ENV=development

# #269 safety valve: the ONLY env file that sets this sentinel. apps/server/vitest.config.ts refuses
# to run the (destructive) server suite unless it is 'server-test' — so a misconfig or a missing setup
# fails fast instead of silently wiping the dev DB.
WIKISTEAD_TEST_STACK=server-test

# Postgres (server-test: host 5434)
DATABASE_URL=postgres://app:app@localhost:5434/app
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5434/app

# Valkey (server-test: host 6381)
VALKEY_URL=redis://localhost:6381

# OpenFGA (server-test: host 8092). STORE_ID/MODEL_ID come from .env.server-test.local.
OPENFGA_API_URL=http://localhost:8092

# Meilisearch (server-test: host 7702)
MEILI_HOST=http://localhost:7702
MEILI_MASTER_KEY=dev_master_key_change_me

# S3-compatible storage (server-test: host 9003, SeaweedFS).
S3_ENDPOINT=http://localhost:9003
S3_REGION=us-east-1
S3_ACCESS_KEY=wksadmin
S3_SECRET_KEY=wksadmin
S3_BUCKET=attachments
S3_FORCE_PATH_STYLE=true
# Plain browser presigned-PUT compatibility (no checksum header). See .env.example.
AWS_REQUEST_CHECKSUM_CALCULATION=WHEN_REQUIRED
AWS_RESPONSE_CHECKSUM_VALIDATION=WHEN_REQUIRED

# Member auth (unused on the in-process buildApp() path, but required at module load).
OIDC_ISSUER=https://auth.example.com/
OIDC_CLIENT_ID=wikistead
OIDC_JWKS_URI=https://auth.example.com/.well-known/jwks.json
OIDC_REDIRECT_URI=http://dev.localhost:4010/auth/callback
OIDC_SECRET_ENC_KEY=7yMsXpBHk5/8edVzkeyWcjhYQTyj7EZDAd3Mz6KQHFo=

SMTP_HOST=localhost
SMTP_PORT=1027
SMTP_SECURE=false
EMAIL_FROM=wikistead <server-test@wikistead.local>
# Mailpit HTTP API (server-test: host 8027) — the email/comments tests read delivered mail here.
MAILPIT_API_URL=http://localhost:8027/api/v1

# #1056: tenantBaseUrl() composes this with a tenant's slug (e.g. `dev` -> http://dev.localhost:5173)
# for reset/invite links. No real network connection is ever made from the server-test suite (it drives
# the app through app.inject(), never a socket), so the port is arbitrary and does not need to vary by
# WKS_STACK_OFFSET the way the app ports above do.
WKS_PUBLIC_BASE_URL=http://localhost:5173

# Guest share tokens.
GUEST_TOKEN_SECRET=server_test_guest_secret
GUEST_TOKEN_TTL_SECONDS=300

# NOTE: the exchange rate-limit knobs (EXCHANGE_RL_IP_MAX/LINK_MAX) are intentionally NOT raised
# here — unlike e2e, the server suite includes share-link-ratelimit.test which asserts the DEFAULT
# thresholds (30/IP, 10/link). The rest of the suite stays under the defaults (it passed against
# dev with defaults), so no other test self-throttles.
