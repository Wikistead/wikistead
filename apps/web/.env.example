# Web dev wiring. Copy to .env.local (gitignored): cp apps/web/.env.example apps/web/.env.local
#
# The API resolves the tenant from the Host header (slug = the first label of the
# hostname), so the browser must reach it on dev.localhost:<port> -> slug "dev" ->
# tenant_dev. Plain "localhost" resolves to slug "localhost" and returns 404.
# (.localhost resolves to 127.0.0.1 in modern browsers; no /etc/hosts needed.)
#
# Keep the web origin on localhost:5173 so it matches the SeaweedFS S3 gateway's
# -s3.allowedOrigins (set in docker-compose.yml) for browser presigned uploads.
VITE_API_URL=http://dev.localhost:4000
VITE_COLLAB_URL=ws://localhost:4100
