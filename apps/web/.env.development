# Dev / e2e default: enable the dev-token bypass (no real IdP needed). Loaded for
# `vite` (mode=development) — local dev and the e2e dev-token web. Production
# builds (mode=production) do NOT load this → real OIDC login.
#
# #427: the bypass is PROVISIONAL — a real cookie session (OIDC login) always wins
# over dev-user, and a DEV badge shows while god-mode is active. To turn the bypass
# off entirely, set VITE_DEV_TOKEN_DISABLE=1 in apps/web/.env.local (un-setting
# VITE_DEV_TOKEN there does NOT work: Vite's precedence puts this mode file above
# .env.local for the same variable).
VITE_DEV_TOKEN=dev-token
