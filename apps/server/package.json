{
  "name": "@kb/server",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'noop'",
    "migrate": "tsx src/migrate.ts",
    "fga:bootstrap": "tsx ../../infra/openfga/bootstrap.ts",
    "fga:seed": "tsx ../../infra/openfga/seed.ts",
    "storage:gc": "tsx src/storage/gc.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@fastify/cors": "^10.0.0",
    "@kb/auth": "workspace:*",
    "@kb/authz": "workspace:*",
    "@kb/entitlements": "workspace:^",
    "@kb/events": "workspace:^",
    "@kb/hooks": "workspace:^",
    "@kb/types": "workspace:*",
    "@openfga/sdk": "^0.7.0",
    "fastify": "^5.0.0",
    "ioredis": "^5.3.0",
    "meilisearch": "^0.45.0",
    "postgres": "^3.4.0",
    "stripe": "^22.2.1",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@openfga/syntax-transformer": "^0.2.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  }
}
