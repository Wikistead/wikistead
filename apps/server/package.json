{
  "name": "@wikistead/server",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ee-host": {
      "types": "./dist/ee-host.d.ts",
      "source": "./src/ee-host.ts",
      "default": "./dist/ee-host.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "dev": "tsc -b -w",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "lint": "echo 'noop'",
    "migrate": "tsx --env-file=../../.env src/migrate.ts",
    "fga:bootstrap": "tsx --env-file=../../.env ../../infra/openfga/bootstrap.ts",
    "fga:seed": "tsx --env-file=../../.env ../../infra/openfga/seed.ts",
    "fga:resync": "tsx --env-file=../../.env ../../infra/openfga/resync.ts",
    "roles:converge": "tsx --env-file=../../.env src/scripts/converge-role-duplicates-536.ts",
    "authz:migrate-comment-553": "tsx --env-file=../../.env src/scripts/migrate-comment-independence-553.ts",
    "fga:migrate-comment-direct": "tsx --env-file=../../.env ../../infra/openfga/migrate-comment-direct.ts",
    "db:seed": "tsx --env-file=../../.env ../../infra/db/seed.ts",
    "storage:gc": "tsx --env-file=../../.env src/storage/gc.ts",
    "search:sync": "tsx --env-file=../../.env src/search-sync.ts",
    "ledger:verify": "tsx --env-file=../../.env src/audit/operator-ledger-cli.ts",
    "tenant:oidc-disable": "tsx --env-file=../../.env src/scripts/oidc-disable.ts",
    "tenant:saml-disable": "tsx --env-file=../../.env src/scripts/saml-disable.ts",
    "tenant:login-methods": "tsx --env-file=../../.env src/scripts/login-methods.ts",
    "tenant:local-admin": "tsx --env-file=../../.env src/scripts/local-admin.ts",
    "orphan:sweep": "tsx --env-file=../../.env src/scripts/orphan-claim-sweep.ts",
    "revisions:gc": "tsx --env-file=../../.env src/scripts/revisions-gc.ts",
    "revisions:backfill": "tsx --env-file=../../.env src/scripts/revisions-backfill.ts",
    "plan:reconcile": "tsx --env-file=../../.env src/scripts/plan-reconcile.ts",
    "tenant:promote": "tsx --env-file=../../.env src/scripts/promote-tenant.ts",
    "private:backfill": "tsx --env-file=../../.env src/scripts/private-sharelink-backfill.ts",
    "viewer-member:backfill": "tsx --env-file=../../.env src/scripts/viewer-member-backfill.ts",
    "test": "tsx ../../infra/openfga/ensure-test-model.ts && vitest run",
    "fga:migrate-editor": "tsx --env-file=../../.env src/scripts/migrate-editor-274.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.658.0",
    "@aws-sdk/s3-request-presigner": "^3.658.0",
    "@fastify/cookie": "^11",
    "@fastify/cors": "^10.0.0",
    "@fastify/formbody": "^8.0.2",
    "@openfga/sdk": "^0.8.1",
    "@simplewebauthn/server": "^13.3.2",
    "@wikistead/auth": "workspace:*",
    "@wikistead/authz": "workspace:*",
    "@wikistead/entitlements": "workspace:^",
    "@wikistead/events": "workspace:^",
    "@wikistead/hooks": "workspace:^",
    "@wikistead/macro-render": "workspace:^",
    "@wikistead/types": "workspace:*",
    "fastify": "^5.0.0",
    "fflate": "^0.8.3",
    "ioredis": "^5.3.0",
    "isomorphic-dompurify": "^3.18.0",
    "jsdom": "^29.1.1",
    "meilisearch": "^0.45.0",
    "nodemailer": "^9.0.1",
    "openid-client": "^6.8.4",
    "postgres": "^3.4.0",
    "stripe": "^22.2.1",
    "yjs": "^13.6.0"
  },
  "devDependencies": {
    "@openfga/syntax-transformer": "^0.2.1",
    "@redocly/openapi-core": "^2.39.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.1",
    "@wikistead/entitlements-cloud": "workspace:^",
    "jose": "^5.9.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "yaml": "^2.9.0"
  }
}
