{
  "name": "wikistead",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --concurrency=15",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "node scripts/server-test-refresh.mjs && turbo run test",
    "test:refresh-store": "node scripts/server-test-refresh.mjs",
    "license:check": "node scripts/check-licenses.mjs",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "docs:check": "tsx scripts/gen-docs.ts --check",
    "lint:no-ee-imports": "node scripts/check-ce-imports.mjs",
    "lint:ee-lever-placement": "node scripts/check-ee-lever-placement.mjs",
    "lint:no-css-modules": "node scripts/check-no-css-modules.mjs",
    "lint:no-control-bytes": "node scripts/check-no-control-bytes.mjs",
    "lint:doc-links": "node scripts/check-doc-links.mjs",
    "lint:deploy-secrets": "node scripts/check-deploy-secrets.mjs",
    "lint:origin-routes": "node scripts/check-origin-routes.mjs",
    "lint:selfhost-profile": "node scripts/check-selfhost-profile.mjs",
    "lint:commit-types": "node scripts/check-commit-types.mjs",
    "build:ee": "turbo run build",
    "search:sync": "pnpm --filter @wikistead/server search:sync",
    "preflight:deploy": "tsx apps/server/src/deploy/preflight-cli.ts",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down",
    "dev:setup": "node scripts/dev-setup.mjs",
    "dev:up": "docker compose up -d && node scripts/dev-setup.mjs",
    "setup:e2e": "node tests/e2e/scripts/up.mjs",
    "test:e2e": "pnpm --filter @wikistead/e2e e2e",
    "teardown:e2e": "node tests/e2e/scripts/down.mjs",
    "setup:server-test": "node scripts/server-test-up.mjs",
    "teardown:server-test": "node scripts/server-test-down.mjs"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.3.0",
    "semantic-release": "^25.0.9",
    "tsx": "^4.19.0",
    "turbo": "^2.1.0",
    "typescript": "^5.6.0"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "^3.1.5",
      "find-my-way": "^9.7.0",
      "immutable": "^4.3.9",
      "js-yaml@4": "^4.3.1",
      "lodash-es": "^4.18.0",
      "nanoid@3": "^3.3.18",
      "nanoid@4": "^5.1.6",
      "postcss@8": "^8.5.18",
      "undici@7": "^7.29.0",
      "vite@5": "^6.4.3"
    }
  }
}
