{
  "name": "knowledge-saas",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "license:check": "license-checker-rseidelsohn --production --onlyAllow 'MIT;MIT OR X11;ISC;Apache-2.0;BSD-2-Clause;BSD-3-Clause;0BSD;Unlicense;CC0-1.0;MPL-2.0;BlueOak-1.0.0;Python-2.0' --excludePackages 'knowledge-saas'",
    "lint:no-ee-imports": "node scripts/check-ce-imports.mjs",
    "build": "turbo run build --filter='!./packages-ee/**' --filter='!./apps-ee/**'",
    "compose:up": "docker compose up -d",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "turbo": "^2.1.0",
    "typescript": "^5.6.0",
    "license-checker-rseidelsohn": "^4.4.2"
  }
}
