model
  schema 1.1

# Authorization model — confirmed design decisions (see ADR-001).
#
# Principals
#   user          – authenticated member (OIDC, any compliant IdP per tenant)
#   group#member  – convenience grouping within a tenant
#   user:*        – PUBLIC (anyone on the internet). Used ONLY for truly public
#                   resources; never as "all members of a tenant" (that is
#                   tenant:T#member). The tuple page:X#view@user:* is the sole
#                   switch between private and public; search's is_public must
#                   stay in sync with it.
#
# Monotonic grant model — no explicit deny.
#   Per-page upgrades (space-viewer to page-editor) use direct tuples.
#   If deny semantics become necessary, add "but not" at that point.
#
# share_link — anonymous wildcard access. The link identity IS the principal.
#   Capability (view vs edit) is encoded in which page relation is written.
#   Expiry is optional: write the tuple WITH condition non_expired for
#   time-bounded links; write WITHOUT condition for permanent links.
#   Revocation = delete the page tuple for this share_link (instant effect
#   on next onAuthenticate call; connected guests hold the JWT until exp).
#
# Inheritance depth — space is the only inheritance level wired now.
#   page#parent is reserved for nested-page inheritance but is intentionally
#   unlinked from permission relations until the requirement surfaces.

type user

type group
  relations
    define member: [user]

type tenant
  relations
    define admin: [user]
    define member: [user, group#member]

type space
  relations
    define tenant: [tenant]
    define manager: [user, group#member] or admin from tenant
    # #274 / ADR-135: the editor SPLIT. `editor_member` = member/manager grants (the write target for
    # member edit grants since #274; viewer_member and template#view reference THIS relation, so a
    # share-link principal can never reach space-scoped templates — the #258/ADR-110 hard boundary).
    # `editor` = editor_member PLUS space EDIT share-links (permanent + time-bounded twin); it is what
    # page#edit_from_space inherits, so one space edit-link tuple grants edit on every published,
    # non-private page in the space (the anonymous-wiki use case). Revoke = delete that one tuple.
    # Migration from the pre-split store (editor held the member types directly) is the two-step
    # fga:migrate-editor sequence — ADR-135 §1a/§1b; a FRESH bootstrap lands this final model directly.
    define editor_member: [user, group#member] or manager
    define editor: [share_link, share_link with non_expired] or editor_member
    # #330 / ADR-141: moderator — MORE than editor in moderation power, LESS than manager. Grants the page
    # `moderate` verb (revert / freeze / patrol + edit-with-bypass) via moderate_from_space; a manager always
    # moderates (`or manager`). It does NOT confer manage (grants/delete/settings stay manage-gated) and does
    # NOT inherit space#editor (no viewer_member / template#view; not in the search denorm — a ruled v1
    # under-permission, ADR-141). Guests can never be moderators (no share_link type).
    define moderator: [user, group#member] or manager
    # #258 / ADR-110: viewer_member = space members who can view (NO public wildcard, NO share_link). It is
    # the MEMBER-ONLY subset of viewer, used by template#view so a public/shared space never exposes its
    # space-scoped templates to guests/anon. Kept as a DIRECT-assignable relation (its own tuples) so the
    # space-grant write path writes it for member grants; wildcards/share_link go to `viewer` only. viewer
    # keeps its own direct types too (backward compat — #100 write-ripple: don't strip a direct-assign type)
    # and unions viewer_member in, so page inheritance (view_base_from_space = viewer from space) is unchanged.
    # #274 / ADR-135: viewer_member references editor_MEMBER (never `editor`) — a space EDIT share-link
    # guest must not inherit viewer_member, or template#view would leak space templates to anonymous
    # guests (the leak the editor split exists to prevent; anti-test-pinned).
    # #330 / ADR-141 §1b (user-approved option 1 2026-07-15): `or moderator` — a space moderator IS a member
    # viewer, so their space appears in listSpaces (space#view = viewer), space-watch/pins work, and they
    # can read + save the space's templates (deliberate widening; moderator has NO share_link type, so
    # the #258 guest boundary is untouched). The page-view SET is unchanged — moderate already implied
    # page view via edit→comment→viewable; this only adds the space-level and template surfaces.
    define viewer_member: [user, group#member] or editor_member or moderator
    # user:* here means public space — only set this tuple intentionally.
    # space-scoped share links: one tuple (space:S#viewer@share_link:Y) grants
    # view access to every page in S. Revoke = delete that tuple (1 op).
    # Permanent links omit condition; time-bounded links use non_expired.
    # (Issuance API implemented in #104 / ADR-038.)
    define viewer: [user, group#member, user:*, share_link, share_link with non_expired] or viewer_member
    define admin: admin from tenant
    # Comment AUDIENCE switch at the space level (#100 / ADR-029 Option B). Toggling comments on a
    # space writes/deletes these wildcard tuples (is_public-style; FGA stays the source of truth):
    #   comment_open@user:*       → members / public viewers may comment on the space's pages
    #   comment_open@share_link:* → guests (ANY view link) may comment on the space's pages
    # Pages inherit this (comment_open from space). Space is the only inheritance level (no per-page
    # override in v1 — that would need non-monotonic deny; deferred). Default OFF (anti-grief).
    define comment_open: [user:*, share_link:*]

# share_link has no relations — the link identity is the principal.
# Its capability and expiry live in the page relation tuples.
type share_link

type page
  relations
    define space: [space]
    # Reserved for future nested-page inheritance. Not wired into any
    # permission relation yet — space is the sole inheritance level for now.
    define parent: [page]

    # #109 / ADR-098: per-page PRIVATE (allowlist) marker. Populating the marker makes the page private:
    # the space-inherited grant paths (manager/editor/viewer from space) are cut, so ONLY the explicit
    # direct grants (the allow list) remain — for view AND edit AND manage (no back door). An empty marker
    # is a 1:1 no-op (the space paths pass through), so existing pages are unchanged. This is the whitelist
    # counterpart to `restricted` (blocklist); the two compose (deny still wins — see view).
    # #244 / ADR-098 addendum: the marker is a PAIR — [user:*, share_link:*]. OpenFGA's typed wildcard
    # `user:*` matches ONLY user-type principals, so a space share-link guest (share_link:Y) slipped past
    # `... but not private` and read private pages via `viewer from space`. share_link:* closes that hole.
    # Both wildcards are always written/deleted together in the write path (a lone user:* over-permits
    # guests; a lone share_link:* over-denies members). `share_link:*` precedent: space#comment_open (:59).
    # public⊥private is a WRITE-BOUNDARY invariant (setting private strips view_base@user:* → is_public
    # false), enforced in the write path, not here — the model can't subtract the DIRECT user:* grant.
    # #218 / ADR-103: private CASCADES down the parent chain (`or private from parent`) so a private folder
    # makes its whole subtree private (monotonic, downward-only; reparent-out is the only escape).
    define private: [user:*, share_link:*] or private from parent

    # #218 / ADR-103: nested-page (folder) grant inheritance. Direct member/group/link grants split into
    # `*_direct` LEAVES so they cascade DOWN the parent chain (a grant on a folder reaches its children) WITHOUT
    # dragging user:* (public) or space inheritance along — `*_from_parent` recurses the LEAF only. user:* stays
    # a DIRECT type on view_base (never cascades → #100 nested-public preserved). The `*_direct` leaves are the
    # WRITE TARGETS for direct grants (manage/edit are purely computed now → a direct write to them fails; the
    # grant write-path writes the leaf — see fgaRelationForCap). Each `... from space` inheritance is still gated
    # by `but not private` via a helper (OpenFGA forbids mixing `or`/`but not` at one level).
    #
    # #218 / ADR-103 addendum (DRAFT GATE): the folder grant-cascade applies ONLY to PUBLISHED pages. `published`
    # is a marker PAIR ([user:*, share_link:*], written at publish alongside page#space) — an UNPUBLISHED draft
    # under a shared/linked folder must stay creator-only (Phase-4 visibility gate: unpublished = creator-only).
    # The `*_from_parent` recursion stays UNGATED (structural walk — it still propagates a grant DOWN through a
    # draft intermediate to a published descendant); the `and published` gate is applied per-page at the point
    # the inherited grant enters `manage`/`edit_base`/`view_base` via a `*_inherited` helper (no or/and mixing at
    # one level). private (more-restrictive) is NOT gated by published — it cascades to drafts too, which is safe.
    define published: [user:*, share_link:*]
    define manage_direct: [user, group#member]
    define manage_from_space: manager from space but not private
    define manage_from_parent: manage_direct from parent or manage_from_parent from parent
    define manage_inherited: manage_from_parent and published
    define manage: manage_direct or manage_from_space or manage_inherited
    # share_link entries appear twice per relation:
    #   share_link             — permanent link (tuple written without condition)
    #   share_link with non_expired — time-bounded link (tuple written with condition)
    # OpenFGA requires both to be declared to allow either form.
    define edit_direct: [user, group#member, share_link, share_link with non_expired]
    define edit_from_space: editor from space but not private
    define edit_from_parent: edit_direct from parent or edit_from_parent from parent
    define edit_inherited: edit_from_parent and published
    define edit_base: edit_direct or edit_from_space or edit_inherited
    # #218 / ADR-103 (A5-5): edit is gated by the monotonic deny too (a folder EDIT-link guest must be
    # excludable from a child), via a helper split.
    define edit_permitted: edit_base but not restricted
    # #329 / ADR-139: page FREEZE — a staged edit lock as a top-level subtraction with a role bypass.
    # Two marker relations, two lock levels; an unfrozen page has both empty (subtraction is a no-op):
    #   frozen        — FULL lock. A [user:*, share_link:*] PAIR (the #244 typed-wildcard lesson: a marker
    #                   must enumerate every principal type it stops), written/deleted together.
    #   frozen_guests — MEMBERS-ONLY lock: share_link:* alone, so only guest (share-link) edit is cut.
    # Subtracting BELOW the manage bypass but ABOVE edit_permitted cuts direct AND inherited edit —
    # including a direct edit@share_link tuple (edit_direct feeds edit_base) — which a private-type freeze
    # could not do. `restricted` (per-principal deny) stays independent inside edit_permitted. Each
    # subtraction is its own helper (OpenFGA forbids mixing `or`/`but not` at one level). NOTE the
    # deliberate breadth (ADR-139): an EDIT-ONLY-link guest holds no view_base, so a full freeze removes
    # their view/comment/collab-join too (anti-vandalism denial); members degrade to read-only; a
    # view+comment-link guest keeps view+comment (`view_base and comment_open` is edit-independent).
    define frozen: [user:*, share_link:*]
    define frozen_guests: [share_link:*]
    define edit_no_guests: edit_permitted but not frozen_guests
    define edit_unfrozen: edit_no_guests but not frozen
    # #330 / ADR-141: the moderate verb (revert C-2 / freeze C-4 / patrol C-1 + edit via the bypass below).
    # PRIVATE-GUARDED like every other `... from space` inheritance (ADR-098 no-back-door): a space
    # moderator NOT on a private page's allowlist gets NO edit and NO view — same as a manager. The direct
    # type ([user, group#member] — the ruling) closes the asymmetry with manage_direct: a moderator
    # can be appointed onto a PRIVATE page individually. moderate bypasses freeze/restricted (role-
    # bypassable denies) by joining the bypass line; private (an allowlist, not a deny) it respects.
    define moderate_from_space: moderator from space but not private
    define moderate: [user, group#member] or moderate_from_space
    # The role bypass sits ABOVE every subtraction: manage and moderate always edit (they fix/unfreeze a
    # frozen page — that is the point of the roles). ADR-139 (C-4) landed manage; ADR-141 (C-5) adds moderate.
    define edit_live: manage or moderate or edit_unfrozen
    # #411 / ADR-153: TRASH cuts edit for EVERYONE including manage (a trashed page is not editable —
    # restore first). manage itself stays UNsubtracted below: it is the trash-listing/restore/purge authority.
    define edit: edit_live but not trashed

    # Commenting authorization (#100 / ADR-029 Option B) — a RESOURCE SETTING, not a link capability.
    # view_direct: direct member/group/link view grants (WRITE TARGET + cascading leaf). user:* (public page)
    # stays a DIRECT type on view_base itself so it does NOT cascade to children (#100). `viewer from space`
    # inheritance is cut when the page is private (ADR-098). Backward compatible when private is empty.
    define view_direct: [user, group#member, share_link, share_link with non_expired]
    define view_base_from_space: viewer from space but not private
    define view_base_from_parent: view_direct from parent or view_base_from_parent from parent
    define view_base_inherited: view_base_from_parent and published
    define view_base: [user:*] or view_direct or view_base_from_space or view_base_inherited
    # comment audience gate, space-inherited (the write/delete switch lives on space#comment_open).
    define comment_open: [user:*, share_link:*] or comment_open from space
    # explicit per-principal comment grant (member/group granularity)  ∪  edit  ∪  the audience gate.
    # A specific member may be granted comment even when the audience toggle is off.
    # #411 / ADR-153: `comment` was the DIRECT WRITE TARGET (fgaRelationForCap) — turning it computed
    # requires the leaf split (the #100 write-ripple lesson). Existing `comment@user/group` tuples are
    # migrated to comment_direct (infra/openfga/migrate-comment-direct.ts). comment_live uses edit_live
    # (pre-subtraction) so the trash subtraction happens exactly once, at `comment`.
    define comment_direct: [user, group#member]
    define comment_live: comment_direct or edit_live or (view_base and comment_open)
    define comment: comment_live but not trashed
    # #109 / ADR-072 · #218 / ADR-103 (A5-1): per-page MONOTONIC DENY. `restricted` gains share_link
    # (UNCONDITIONAL — a `with non_expired` deny would be non-monotonic) so a folder-share-link guest can be
    # excluded from a specific child. NOT share_link:* (that over-denies every link). Deny wins over every grant
    # path; both `view` (viewable but not) AND `edit` (edit_permitted) subtract it. Direct view grants stay on
    # `view_direct` (the leaf, so direct writes are unaffected).
    define restricted: [user, group#member, share_link]
    # viewable = direct viewers OR anyone who can comment (commenters can view). Acyclic:
    # comment → {view_base, comment_open, edit}; viewable → {view_base, comment}; view_base is a leaf.
    define viewable: view_base or comment
    # view = viewable MINUS restricted (monotonic deny). Every `view` check (routes, revisions, search
    # stage-2, public anon) inherits the deny.
    define view_live: viewable but not restricted
    # #411 / ADR-153: the TRASH marker — a [user:*, share_link:*] PAIR (#244 typed-wildcard lesson),
    # written/deleted together for a whole trashed subtree. Subtracted from view/edit/comment so a trashed
    # page is INVISIBLE everywhere through the existing per-item checks (uniform 404 — byte-identical to
    # absent), while every underlying grant tuple survives in place: restore = delete the pair, and the
    # page comes back with exactly its prior direct access. manage/moderate are NOT subtracted (they are
    # the restore authority; the trash LISTING view-filters per-entry on manage).
    define trashed: [user:*, share_link:*]
    define view: view_live but not trashed

# #241 / ADR-110: page templates. A template is a snapshot (the row lives in the `templates` table with
# tenant RLS); THIS type carries the audience authorization. Scope is expressed by which tuples exist —
# ADDITIVE (no existing type changed, so no write ripple):
#   personal : owner + tenant only            → view = manage (owner or tenant admin)
#   space    : + space:S                       → view also = viewer_member from space (that space's MEMBERS)
#   tenant   : + audience_all@tenant:T         → view also = member from audience_all (all tenant members)
# Guests (share_link) and public (user:*) NEVER appear here → templates are never guest/public-visible.
# #258: template#view inherits `viewer_member from space`, NOT `viewer from space`. viewer includes the
# public wildcard + share_link (a public/shared space's pages are anon-viewable), so inheriting it would
# leak space-scoped templates to guests/anon (the documented hard boundary above). viewer_member is the
# member-only subset, so the boundary holds — asserted by the space-scope × public/shared anti-tests.
# Changing scope = writing/deleting ONE tuple. A deleted space degrades to owner/admin visibility (the
# snapshot row stays). manage (rename/delete) = the owner or a tenant admin, re-checked server-side.
type template
  relations
    define tenant: [tenant]
    define space: [space]
    # audience_all present (@tenant:T) means the whole tenant is the audience (scope = tenant).
    define audience_all: [tenant]
    define owner: [user]
    define manage: owner or admin from tenant
    define view: manage or member from audience_all or viewer_member from space

# Evaluated at check time using current_time from the check context.
# expires_at is stored in the tuple condition context at write time.
# Tuples written WITHOUT this condition are permanent (no expiry check).
condition non_expired(current_time: timestamp, expires_at: timestamp) {
  current_time < expires_at
}
