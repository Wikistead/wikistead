model
  schema 1.1

# Authorization model — confirmed design decisions (see ADR-001).
#
# Principals
#   user          – authenticated member (OIDC, any compliant IdP per tenant)
#   group#member  – convenience grouping within a tenant
#   user:*        – PUBLIC (anyone on the internet). Used ONLY for truly public
#                   resources; never as "all members of a tenant" (that is
#                   tenant:T#member). The tuple page:X#view@user:* is the sole
#                   switch between private and public; search's is_public must
#                   stay in sync with it.
#
# Monotonic grant model — no explicit deny.
#   Per-page upgrades (space-viewer to page-editor) use direct tuples.
#   If deny semantics become necessary, add "but not" at that point.
#
# share_link — anonymous wildcard access. The link identity IS the principal.
#   Capability (view vs edit) is encoded in which page relation is written.
#   Expiry is optional: write the tuple WITH condition non_expired for
#   time-bounded links; write WITHOUT condition for permanent links.
#   Revocation = delete the page tuple for this share_link (instant effect
#   on next onAuthenticate call; connected guests hold the JWT until exp).
#
# Inheritance depth — space is the only inheritance level wired now.
#   page#parent is reserved for nested-page inheritance but is intentionally
#   unlinked from permission relations until the requirement surfaces.

type user

type group
  relations
    define member: [user]

type tenant
  relations
    define admin: [user]
    define member: [user, group#member]

type space
  relations
    define tenant: [tenant]
    define manager: [user, group#member] or admin from tenant
    define editor: [user, group#member] or manager
    # #258 / ADR-110: viewer_member = space members who can view (NO public wildcard, NO share_link). It is
    # the MEMBER-ONLY subset of viewer, used by template#view so a public/shared space never exposes its
    # space-scoped templates to guests/anon. Kept as a DIRECT-assignable relation (its own tuples) so the
    # space-grant write path writes it for member grants; wildcards/share_link go to `viewer` only. viewer
    # keeps its own direct types too (backward compat — #100 write-ripple: don't strip a direct-assign type)
    # and unions viewer_member in, so page inheritance (view_base_from_space = viewer from space) is unchanged.
    define viewer_member: [user, group#member] or editor
    # user:* here means public space — only set this tuple intentionally.
    # space-scoped share links: one tuple (space:S#viewer@share_link:Y) grants
    # view access to every page in S. Revoke = delete that tuple (1 op).
    # Permanent links omit condition; time-bounded links use non_expired.
    # (Issuance API implemented in #104 / ADR-038.)
    define viewer: [user, group#member, user:*, share_link, share_link with non_expired] or viewer_member
    define admin: admin from tenant
    # Comment AUDIENCE switch at the space level (#100 / ADR-029 Option B). Toggling comments on a
    # space writes/deletes these wildcard tuples (is_public-style; FGA stays the source of truth):
    #   comment_open@user:*       → members / public viewers may comment on the space's pages
    #   comment_open@share_link:* → guests (ANY view link) may comment on the space's pages
    # Pages inherit this (comment_open from space). Space is the only inheritance level (no per-page
    # override in v1 — that would need non-monotonic deny; deferred). Default OFF (anti-grief).
    define comment_open: [user:*, share_link:*]

# share_link has no relations — the link identity is the principal.
# Its capability and expiry live in the page relation tuples.
type share_link

type page
  relations
    define space: [space]
    # Reserved for future nested-page inheritance. Not wired into any
    # permission relation yet — space is the sole inheritance level for now.
    define parent: [page]

    # #109 / ADR-098: per-page PRIVATE (allowlist) marker. Populating the marker makes the page private:
    # the space-inherited grant paths (manager/editor/viewer from space) are cut, so ONLY the explicit
    # direct grants (the allow list) remain — for view AND edit AND manage (no back door). An empty marker
    # is a 1:1 no-op (the space paths pass through), so existing pages are unchanged. This is the whitelist
    # counterpart to `restricted` (blocklist); the two compose (deny still wins — see view).
    # #244 / ADR-098 addendum: the marker is a PAIR — [user:*, share_link:*]. OpenFGA's typed wildcard
    # `user:*` matches ONLY user-type principals, so a space share-link guest (share_link:Y) slipped past
    # `... but not private` and read private pages via `viewer from space`. share_link:* closes that hole.
    # Both wildcards are always written/deleted together in the write path (a lone user:* over-permits
    # guests; a lone share_link:* over-denies members). `share_link:*` precedent: space#comment_open (:59).
    # public⊥private is a WRITE-BOUNDARY invariant (setting private strips view_base@user:* → is_public
    # false), enforced in the write path, not here — the model can't subtract the DIRECT user:* grant.
    # (#218 will extend this line to `... or private from parent` for nested-page inheritance; rebase onto
    # this pair when it lands.)
    define private: [user:*, share_link:*]

    # Each `... from space` inheritance is gated by `but not private` via a helper (OpenFGA forbids mixing
    # `or` and `but not` at one level). Private → the helper is empty → only direct grants survive.
    define manage_from_space: manager from space but not private
    define manage: [user, group#member] or manage_from_space
    # share_link entries appear twice per relation:
    #   share_link             — permanent link (tuple written without condition)
    #   share_link with non_expired — time-bounded link (tuple written with condition)
    # OpenFGA requires both to be declared to allow either form.
    define edit_from_space: editor from space but not private
    define edit: [user, group#member, share_link, share_link with non_expired] or manage or edit_from_space

    # Commenting authorization (#100 / ADR-029 Option B) — a RESOURCE SETTING, not a link capability.
    # Split view into `view_base` (the direct view grants — the leaf) so `comment` can intersect on it
    # without the view→comment→view cycle. Links carry view/edit ONLY; a guest comments via a VIEW
    # link + comments being open (view_base and comment_open), never via a comment link.
    #
    # view_base: direct view grants ONLY (user:* here = public page — keep in sync with search is_public).
    # The `viewer from space` inheritance is cut when the page is private (ADR-098) — only the direct
    # grants above (the allow list) remain. Backward compatible when private is empty.
    define view_base_from_space: viewer from space but not private
    define view_base: [user, group#member, user:*, share_link, share_link with non_expired] or view_base_from_space
    # comment audience gate, space-inherited (the write/delete switch lives on space#comment_open).
    define comment_open: [user:*, share_link:*] or comment_open from space
    # explicit per-principal comment grant (member/group granularity)  ∪  edit  ∪  the audience gate.
    # A specific member may be granted comment even when the audience toggle is off.
    define comment: [user, group#member] or edit or (view_base and comment_open)
    # #109 / ADR-072: per-page MONOTONIC DENY. A principal listed in `restricted` cannot view the page
    # even if they'd otherwise qualify (space viewer, direct grant, commenter) — deny wins over every
    # grant path. This is the "space viewer but page restricted → denied" case. Direct view grants stay
    # on `view_base` (the leaf, so direct writes are unaffected); the search denormaliser reads
    # view_base/comment (§doc-builder) and is NOT changed by this, while search stage-2 checks `view`
    # (now excluding restricted), so a restricted user is filtered even from a public / denormalised
    # page. `viewable` splits the union out because OpenFGA exclusion (`but not`) subtracts from a
    # single base userset.
    define restricted: [user, group#member]
    # viewable = direct viewers OR anyone who can comment (commenters can view). Acyclic:
    # comment → {view_base, comment_open, edit}; viewable → {view_base, comment}; view_base is a leaf.
    define viewable: view_base or comment
    # view = viewable MINUS restricted (monotonic deny). Every `view` check (routes, revisions, search
    # stage-2, public anon) inherits the deny.
    define view: viewable but not restricted

# #241 / ADR-110: page templates. A template is a snapshot (the row lives in the `templates` table with
# tenant RLS); THIS type carries the audience authorization. Scope is expressed by which tuples exist —
# ADDITIVE (no existing type changed, so no write ripple):
#   personal : owner + tenant only            → view = manage (owner or tenant admin)
#   space    : + space:S                       → view also = viewer_member from space (that space's MEMBERS)
#   tenant   : + audience_all@tenant:T         → view also = member from audience_all (all tenant members)
# Guests (share_link) and public (user:*) NEVER appear here → templates are never guest/public-visible.
# #258: template#view inherits `viewer_member from space`, NOT `viewer from space`. viewer includes the
# public wildcard + share_link (a public/shared space's pages are anon-viewable), so inheriting it would
# leak space-scoped templates to guests/anon (the documented hard boundary above). viewer_member is the
# member-only subset, so the boundary holds — asserted by the space-scope × public/shared anti-tests.
# Changing scope = writing/deleting ONE tuple. A deleted space degrades to owner/admin visibility (the
# snapshot row stays). manage (rename/delete) = the owner or a tenant admin, re-checked server-side.
type template
  relations
    define tenant: [tenant]
    define space: [space]
    # audience_all present (@tenant:T) means the whole tenant is the audience (scope = tenant).
    define audience_all: [tenant]
    define owner: [user]
    define manage: owner or admin from tenant
    define view: manage or member from audience_all or viewer_member from space

# Evaluated at check time using current_time from the check context.
# expires_at is stored in the tuple condition context at write time.
# Tuples written WITHOUT this condition are permanent (no expiry check).
condition non_expired(current_time: timestamp, expires_at: timestamp) {
  current_time < expires_at
}
